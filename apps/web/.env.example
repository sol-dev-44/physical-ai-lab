# Public site URL, used for auth redirects and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Settings > API). The site builds and serves content without these;
# run data and /admin need them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated emails allowed into /admin. Must also exist in public.admins (see supabase/).
ADMIN_EMAILS=

# Shared secret the lab-agent sync uses to call /api/revalidate after publishing a run.
REVALIDATE_SECRET=
