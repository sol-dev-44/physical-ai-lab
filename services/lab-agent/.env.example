# services/lab-agent/.env — lives only on the lab machine. Never commit.
LAB_TOOLS=exp000_ir_bridge.tools:build
LAB_EVENTS_DIR=../../events
LAB_AGENT_ID=mac-studio

# Service role key: full database access. Only this machine has it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# For revalidating the site after sync.
SITE_URL=http://localhost:3000
REVALIDATE_SECRET=

# exp000 device addresses
RM4_HOST=192.168.1.50
